{
  "name": "@heedvane/connector",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Customer-run code-host connector: one outbound WebSocket tunnel to the Heedvane connector gateway, serving an allowlisted subset of GitLab API and git traffic plus local webhook intake.",
  "bin": {
    "heedvane-connector": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "test": "tsx --test --test-concurrency=1 --test-timeout=60000 src/*.test.ts"
  },
  "dependencies": {
    "@heedvane/connector-protocol": "workspace:*",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
